# Smart Farming Frontend (.env.example)
# Copy to .env and adjust as needed

# Backend HTTP base URL (used by Axios client)
REACT_APP_API_BASE=http://localhost:8000

# WebSocket base URL (used by ws.js)
REACT_APP_WS_URL=ws://localhost:8000/ws

# Optional logging level: error | warn | info | debug
REACT_APP_LOG_LEVEL=info

# Optional comma-separated feature flags, e.g. mockCharts=true
REACT_APP_FEATURE_FLAGS=mockCharts=true

# Optional: Node environment (defaults to development)
REACT_APP_NODE_ENV=development
